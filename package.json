{
	"name": "dump-verifier",
	"version": "2.0.8",
	"description": "A tool to verify game dumps using the redump.org and no-intro.org databases.",
	"license": "Apache-2.0",
	"author": "Óscar Maganto Torres",
	"main": "dist/js/main.cjs",
	"type": "module",
	"scripts": {
		"start": "electron-forge start",
		"make": "node --no-warnings --experimental-strip-types esbuild.config.ts build && electron-forge make --arch=x64 && electron-forge make --arch=arm64",
		"watch": "node --no-warnings --experimental-strip-types esbuild.config.ts watch",
		"build": "node --no-warnings --experimental-strip-types esbuild.config.ts build",
		"release": "electron-forge make"
	},
	"keywords": [],
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"boolean": "^3.2.0",
		"countries-list": "^3.4.1",
		"electron-squirrel-startup": "^1.0.1",
		"esbuild-sass-plugin": "^3.7.0",
		"eslint": "^10.15.0",
		"eslint-plugin-jsdoc": "^65.5.3",
		"fastest-levenshtein": "^1.0.16",
		"glob": "^14.0.6",
		"jquery": "^4.1.0",
		"js-confetti": "^0.13.1",
		"jszip": "^3.10.2",
		"keytar": "^7.9.0",
		"lefthook": "^2.2.2",
		"prettier": "^3.10.1",
		"tar": "^7.5.23",
		"tippy.js": "^6.3.7",
		"tom-select": "^2.7.0",
		"typescript-eslint": "^8.74.0"
	},
	"devDependencies": {
		"@electron-forge/cli": "^8.0.1",
		"@electron-forge/maker-squirrel": "^8.0.1",
		"@electron-forge/maker-zip": "^8.0.1",
		"@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
		"@electron-forge/plugin-fuses": "^8.0.1",
		"@electron/fuses": "^2.1.3",
		"@forkprince/electron-forge-maker-appimage": "^1.0.2",
		"@types/jquery": "^4.0.1",
		"@types/tippy.js": "^6.3.0",
		"depcheck": "^1.4.7",
		"electron": "^45.4.1",
		"esbuild": "^0.28.2"
	}
}
